{
    "name": "com.jewellery.store.management.system",
    "version": "0.0.0",
    "description": "Offline-first jewellery store management system (POS) for single-shop Indian jewellers.",
    "author": "Harshil Sharaf",
    "main": "src-electron/main.js",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build --base-href ./ --configuration=production",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "test:db": "node --test \"src-electron/db/**/*.test.js\"",
        "dev": "ng serve",
        "electron": "electron .",
        "electron-dev": "concurrently \"ng serve\" \"npm run electron\"",
        "electron-build": "npm run build && set ELECTRON_IS_DEV=0 && electron .",
        "pack": "npm run build && electron-builder --dir",
        "dist": "npm run build && electron-builder"
    },
    "private": true,
    "engines": {
        "node": ">=20.19.0"
    },
    "dependencies": {
        "@angular/animations": "^21.2.18",
        "@angular/cdk": "^21.2.9",
        "@angular/common": "^21.2.18",
        "@angular/compiler": "^21.2.18",
        "@angular/core": "^21.2.18",
        "@angular/forms": "^21.2.18",
        "@angular/localize": "^21.2.18",
        "@angular/platform-browser": "^21.2.18",
        "@angular/platform-browser-dynamic": "^21.2.18",
        "@angular/router": "^21.2.18",
        "animate.css": "^4.1.1",
        "base64-js": "^1.5.1",
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^13.0.1",
        "chart.js": "^4.5.1",
        "dayjs": "^1.11.21",
        "electron-log": "^5.4.4",
        "electron-store": "^8.2.0",
        "ngx-image-compress": "^18.1.7",
        "ngx-print": "^22.1.1",
        "ngx-skeleton-loader": "^13.0.0",
        "ngx-ui-loader": "^19.0.0",
        "rxjs": "^7.8.2",
        "serialport": "^12.0.0",
        "tslib": "^2.8.1",
        "zone.js": "~0.16.0"
    },
    "devDependencies": {
        "@angular/build": "^21.2.18",
        "@angular/cli": "^21.2.18",
        "@angular/compiler-cli": "^21.2.18",
        "@ng-icons/core": "^34.0.0",
        "@ng-icons/lucide": "^34.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jasmine": "^6.0.0",
        "autoprefixer": "^10.5.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^8.2.2",
        "electron": "^40.4.1",
        "electron-builder": "^25.1.8",
        "jasmine-core": "~5.6.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "postcss": "^8.5.20",
        "tailwind-merge": "^2.6.1",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "~5.9.0"
    },
    "overrides": {
        "@hono/node-server": "^2.0.5"
    },
    "build": {
        "appId": "com.jewellery.store.management.system",
        "productName": "Jewellery Store Manager",
        "artifactName": "${productName}-${version}-${arch}.${ext}",
        "directories": {
            "output": "release"
        },
        "npmRebuild": false,
        "buildDependenciesFromSource": false,
        "files": [
            "dist/**/*",
            "src-electron/**/*",
            "Backend/**/*",
            "package.json"
        ],
        "asarUnpack": [
            "**/node_modules/better-sqlite3/**",
            "**/node_modules/serialport/**",
            "**/node_modules/@serialport/**",
            "**/*.node"
        ],
        "win": {
            "signAndEditExecutable": false,
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false
        }
    }
}
