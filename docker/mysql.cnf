[mysqld]
# MySQL 8.4 LTS defaults tuned for Tier-2/3 shop hardware (integrated SATA SSDs,
# 4-8 GB RAM). Two defaults changed between 8.0 and 8.4 that thrash slow SSDs:
#   - innodb_io_capacity default 200 -> 10000 (fantasy IOPS on shop-counter PCs)
#   - innodb_change_buffering default all -> NONE (write-perf regression for
#     the small-transaction workload this POS runs)
# Everything else (O_DIRECT flush, 64 MB log buffer, adaptive hash off) is kept
# at 8.4's new defaults on purpose — they are genuinely better here.
innodb_io_capacity      = 200
innodb_change_buffering = all
