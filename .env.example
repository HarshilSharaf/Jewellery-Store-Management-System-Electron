# =====================================================================
# Environment configuration for the Jewellery Store Management System.
# Copy this file to `.env` (which is git-ignored) and edit the values.
#
# These variables are consumed by two places:
#   1. docker-compose.yml -- to boot the local MySQL container.
#   2. src-electron/main.js -- as fallback defaults when no user-supplied
#      connection info exists in electron-store yet (first launch case).
#
# The renderer (Angular) never reads .env directly -- Electron's main
# process passes any resolved values to the renderer over IPC.
# =====================================================================

# MySQL root password (used by the container at first boot to initialise data)
MYSQL_ROOT_PASSWORD=root@123

# Database (schema) name that will hold all app tables
MYSQL_DATABASE=jewellery

# Application user + password created inside the container. The app
# connects using these, NOT root.
MYSQL_USER=zeus_user
MYSQL_PASSWORD=zeus@123

# Host / port that the Electron app uses to reach MySQL. Leave as
# localhost / 3306 when running docker-compose on the same machine as the
# Electron app.
MYSQL_HOST=localhost
MYSQL_PORT=3306
